# ===========================================================
# baleen · 环境变量样例
# 用法:cp .env.example .env,然后按需修改
# 所有变量都有默认值,不建 .env 也能跑;这里只放样例值,真实密钥永不入库
# ===========================================================

# ---------- PostgreSQL(docker compose 的 db 服务读 POSTGRES_*) ----------
POSTGRES_USER=baleen
POSTGRES_PASSWORD=baleen
POSTGRES_DB=baleen
POSTGRES_PORT=5432

# ---------- 后端(FastAPI 读以下变量) ----------

# 数据库连接串(SQLAlchemy async + asyncpg)
DATABASE_URL=postgresql+asyncpg://baleen:baleen@localhost:5432/baleen

# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# 允许跨域的前端来源,逗号分隔;前端 dev 默认 5173
CORS_ORIGINS=http://localhost:5173

# ---------- Embedding(本地模型,AGENTS.md §5 决策 4) ----------

# bge-large-zh-v1.5 的本地 HF cache 路径;代码里不许硬编码,一律读这里
EMBEDDING_MODEL_PATH=C:\Users\MOM\Desktop\学习项目\智能笔记库\models\bge-large-zh-v1.5
