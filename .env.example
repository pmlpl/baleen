# ===========================================================
# baleen · 环境变量样例
# 用法:cp .env.example .env,然后按需修改
# 所有变量都有默认值,不建 .env 也能跑;这里只放样例值,真实密钥永不入库
# ===========================================================

# ---------- PostgreSQL(docker compose 的 db 服务读 POSTGRES_*) ----------
POSTGRES_USER=baleen
POSTGRES_PASSWORD=baleen
POSTGRES_DB=baleen
POSTGRES_PORT=5432

# ---------- 后端(FastAPI 读以下变量) ----------

# 数据库连接串(SQLAlchemy async + asyncpg)
DATABASE_URL=postgresql+asyncpg://baleen:baleen@localhost:5432/baleen

# Redis 连接串
REDIS_URL=redis://localhost:6379/0

# 允许跨域的前端来源,逗号分隔;前端 dev 默认 5173
CORS_ORIGINS=http://localhost:5173

# ---------- Embedding(本地模型,AGENTS.md §5 决策 4) ----------

# bge-large-zh-v1.5 的本地 HF cache 路径;代码里不许硬编码,一律读这里
EMBEDDING_MODEL_PATH=C:\Users\MOM\Desktop\学习项目\智能笔记库\models\bge-large-zh-v1.5

# API 进程启动后后台线程预加载嵌入模型(消除重启后第一问的冷启动等待);false 关掉
EMBED_WARMUP_ON_STARTUP=true

# ---------- LLM(OpenAI 兼容协议;G2 归属闸用,用户自带 key)----------

# 任意 OpenAI 兼容服务的 base url(必须含版本前缀,如 /v1)
LLM_BASE_URL=https://api.openai.com/v1

# 你的 key;真实值只写进 .env(已 gitignore),永不提交
LLM_API_KEY=sk-REPLACE_ME

# 模型名;按所接服务支持的模型填
LLM_MODEL=gpt-4o-mini

# v1 单库:自然语言 charter(收什么/不收什么);留空则用代码里的示例
CHARTER=我是一名软件过程技术方向的本科生,只收以后还用得上的知识
